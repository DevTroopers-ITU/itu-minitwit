        <mxCell id="p6_body" value="&#10;DO cloud firewall&#10;blocked Swarm ports&#10;between our own&#10;nodes&#10;&#10;PR #131: Traefik&#10;v3.6 + overlay fix&#10;&#10;PR #138: latest&#10;counter → PG&#10;&#10;UFW + tag rules&#10;PR #141: GHCR&#10;PAT fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E76F51;fontSize=9;align=center;verticalAlign=top;spacing=3;" vertex="1" parent="1">
