        <mxCell id="p4" value="PHASE 4 — Quality + logging&#10;&#10;• PR #77: gofmt + golangci-lint&#10;  + hadolint in CI (Mar 13)&#10;• errcheck, govet, staticcheck enabled&#10;• Loki + Promtail (Mar 30) — global&#10;• Discord webhook alerts wired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2E86AB;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
